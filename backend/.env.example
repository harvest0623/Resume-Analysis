# ========================================
# Coze API 环境变量配置
# ========================================
#
# 命名规范说明：
# - 每个工作流使用独立的 API_KEY 和 WORKFLOW_URL
# - 变量名格式：COZE_API_KEY_{WORKFLOW_NAME} 和 COZE_WORKFLOW_URL_{WORKFLOW_NAME}
# - WORKFLOW_NAME 使用大写字母，语义化命名（如 ANALYZE、COMPARE）
#
# 新增工作流配置示例：
# COZE_API_KEY_YOUR_WORKFLOW=your_api_key_here
# COZE_WORKFLOW_URL_YOUR_WORKFLOW=your_workflow_url_here
# ========================================


# ========================================
# 简历分析工作流配置 (ANALYZE)
# ========================================
# 用途：单份简历的智能分析，提取技能、经验、教育等维度评分
# 输入：简历文本内容、基本信息
# 输出：综合评分、各维度评分、分析报告、改进建议
# 格式要求：
#   - API_KEY: Bearer Token 格式，从 Coze 平台获取
#   - URL: 工作流 API 端点，格式为 https://xxx.coze.site/run
COZE_API_KEY_ANALYZE=your_coze_api_key_here
COZE_WORKFLOW_URL_ANALYZE=your_coze_workflow_url_here

# ========================================
# 简历比较工作流配置 (COMPARE)
# ========================================
# 用途：多份简历（2-5份）的批量比较分析
# 输入：
#   - resumes: 简历数组，每份包含 id、text、basic_info、background、skills
#   - job_description: 岗位描述
#   - requirements: 岗位要求
#   - config: 权重配置（skills_weight、experience_weight、education_weight）
# 输出：
#   - results: 各简历的匹配分数和详细分析
#   - comparison: 排名、优势/劣势分析、推荐建议
# 格式要求：
#   - API_KEY: Bearer Token 格式，从 Coze 平台获取
#   - URL: 工作流 API 端点，格式为 https://xxx.coze.site/compare/run
#   - 输入 JSON 示例：
#     {
#       "resumes": [
#         {
#           "id": "resume_001",
#           "text": "简历全文...",
#           "basic_info": {"name": "张三", "phone": "138xxx", "email": "xxx@example.com"},
#           "background": {"work_years": "5年", "education": "硕士", "major": "计算机科学", "university": "清华大学"},
#           "skills": ["Python", "React", "Docker"]
#         }
#       ],
#       "job_description": "岗位描述...",
#       "requirements": "岗位要求...",
#       "config": {"skills_weight": 0.45, "experience_weight": 0.30, "education_weight": 0.25}
#     }
COZE_API_KEY_COMPARE=your_coze_api_key_here
COZE_WORKFLOW_URL_COMPARE=your_coze_workflow_url_here

# ========================================
# 简历优化建议工作流配置 (OPTIMIZE)
# ========================================
# 用途：为单份简历提供个性化的优化建议
# 输入：
#   - resume_text: 简历的完整文本内容
#   - basic_info: 基本信息对象（name、phone、email）
# 输出：
#   - analysis: 简历整体分析评价
#   - suggestions: 优化建议列表
# 格式要求：
#   - API_KEY: Bearer Token 格式，从 Coze 平台获取
#   - URL: 工作流 API 端点，格式为 https://xxx.coze.site/run
#   - 输入 JSON 示例：
#     {
#       "resume_text": "简历全文...",
#       "basic_info": {"name": "张三", "phone": "138xxx", "email": "xxx@example.com"}
#     }
COZE_API_KEY_OPTIMIZE=your_coze_api_key_here
COZE_WORKFLOW_URL_OPTIMIZE=https://c5gjvzyhxg.coze.site/run

# ========================================
# AI 生成简历工作流配置 (GENERATE)
# ========================================
# 用途：根据用户填写的信息生成专业简历内容
# 输入：
#   - basic_info: 基本信息对象（name、phone、email、target_position、work_years）
#   - education: 教育背景对象（education、school、major）
#   - experience: 经历对象（work_experience、internship_experience、projects）
#   - skills: 技能标签数组
#   - blog: 个人博客地址
#   - self_intro: 自我评价
#   - custom_modules: 自定义模块数组，每项包含 title 和 fields
# 输出：
#   - sections: 简历模块数组，每项包含 title 和 content
#   - summary: 简历内容摘要
# 格式要求：
#   - API_KEY: Bearer Token 格式，从 Coze 平台获取
#   - URL: 工作流 API 端点，格式为 https://xxx.coze.site/generate/run
#   - 输入 JSON 示例：
#     {
#       "basic_info": {
#         "name": "张三",
#         "phone": "138xxx",
#         "email": "xxx@example.com",
#         "target_position": "前端工程师",
#         "work_years": "3-5年"
#       },
#       "education": {
#         "education": "本科",
#         "school": "北京大学",
#         "major": "计算机科学与技术"
#       },
#       "experience": {
#         "work_experience": "2020-2023 字节跳动 前端工程师...",
#         "internship_experience": "2019 腾讯 前端实习生...",
#         "projects": "项目1：电商平台前端开发..."
#       },
#       "skills": ["React", "TypeScript", "Node.js"],
#       "blog": "https://blog.example.com",
#       "self_intro": "3年前端开发经验，熟悉React生态...",
#       "custom_modules": [
#         {
#           "title": "获奖荣誉",
#           "fields": [
#             {"label": "ACM竞赛", "value": "省级一等奖"}
#           ]
#         }
#       ]
#     }
COZE_API_KEY_GENERATE=your_coze_api_key_here
COZE_WORKFLOW_URL_GENERATE=your_coze_workflow_url_here
